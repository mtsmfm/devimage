#!/usr/bin/env bash
# Start / stop / inspect the on-demand GUI stack.
#
# The Dockerfile pulls the GUI longrun services (Xvfb, openbox/labwc, selkies,
# pulseaudio, dbus, nginx, ...) out of s6-overlay's default `user` bundle and
# parks them in a `gui` bundle that doesn't auto-start. This script flips that
# bundle on or off via s6-rc.

set -euo pipefail

bundle=gui

# s6-rc lives in the s6-overlay command tree under /command.
s6_rc=/command/s6-rc

svc_list=(svc-de svc-selkies svc-xorg svc-xsettingsd svc-pulseaudio svc-dbus svc-nginx)

run_s6_rc() {
  if [[ $EUID -eq 0 ]]; then
    "${s6_rc}" "$@"
  else
    sudo "${s6_rc}" "$@"
  fi
}

print_status() {
  local up
  up="$(run_s6_rc -a list 2>/dev/null || true)"
  for svc in "${svc_list[@]}"; do
    if grep -qx "${svc}" <<<"${up}"; then
      echo "up   ${svc}"
    else
      echo "down ${svc}"
    fi
  done
}

case "${1:-status}" in
  start)
    run_s6_rc -u change "${bundle}"
    echo "devimage: gui bundle requested"
    print_status
    ;;
  stop)
    run_s6_rc -d change "${bundle}"
    echo "devimage: gui bundle stopped"
    ;;
  status)
    print_status
    ;;
  *)
    echo "usage: devimage-gui start|stop|status" >&2
    exit 2
    ;;
esac
